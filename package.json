{
  "name": "brisasoft-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static multilingual website for Brisasoft (EN / JA / VI). No dependencies.",
  "scripts": {
    "build": "node build.mjs",
    "build:stg": "SITE_ENV=staging node build.mjs",
    "test": "node --test",
    "dev": "node build.mjs && node serve.mjs",
    "deploy:stg": "SITE_ENV=staging wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
