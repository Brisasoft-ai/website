{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brisasoft-web",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "node build.mjs"
  },
  "routes": [
    { "pattern": "brisasoft.net", "custom_domain": true },
    { "pattern": "www.brisasoft.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  }
}
