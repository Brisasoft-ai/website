{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brisasoft-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "node build.mjs"
  },
  "routes": [
    { "pattern": "brisasoft.net", "custom_domain": true },
    { "pattern": "www.brisasoft.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {
      "name": "brisasoft-web-preview",
      "workers_dev": true,
      "routes": [],
      "build": {
        "command": "node build.mjs"
      },
      "observability": {
        "enabled": true
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page"
      }
    },
    "staging": {
      "name": "brisasoft-web-stg",
      "build": {
        "command": "node build.mjs"
      },
      "routes": [
        { "pattern": "stg.brisasoft.net", "custom_domain": true }
      ],
      "observability": {
        "enabled": true
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page"
      }
    }
  }
}
